{
  "name": "@lumine-code/service-hub",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides semantically versioned service registration and consumption.",
  "main": "./lib/service-hub",
  "scripts": {
    "build": "coffee --compile --output lib src",
    "clean": "node -e \"require('node:fs').rmSync('lib', {recursive: true, force: true})\"",
    "prepare": "npm run build",
    "test": "npm run build && jasmine-focused --coffee --captureExceptions --forceexit spec"
  },
  "repository": "https://github.com/lumine-code/service-hub",
  "bugs": "https://github.com/lumine-code/service-hub/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "event-kit": "^2.5.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@lumine-code/jasmine-focused": "https://github.com/lumine-code/jasmine-focused.git#6d04426bcb107dc44b148a6d48172c918326c068",
    "coffeescript": "2.7.0"
  }
}
